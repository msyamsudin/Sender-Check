{
  "name": "sender-check",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Pemeriksa konsistensi display name pengirim dengan alamat emailnya, dengan penjelasan bukti. Client-side, tanpa network request, tanpa AI/ML, tanpa database brand.",
  "license": "MIT",
  "author": "msyamsudin",
  "homepage": "https://github.com/msyamsudin/Sender-Check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msyamsudin/Sender-Check.git"
  },
  "bugs": {
    "url": "https://github.com/msyamsudin/Sender-Check/issues"
  },
  "keywords": [
    "email-security",
    "phishing",
    "sender-identity",
    "display-name",
    "typosquatting",
    "homoglyph",
    "punycode",
    "public-suffix-list",
    "browser-extension",
    "gmail"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=tools/corpus/reports/test-report.json",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/extension/tsconfig.json",
    "verify": "pnpm typecheck && pnpm console:build && pnpm extension:build && pnpm docs:check && pnpm test:report && pnpm docs:claims && pnpm changelog:check && pnpm corpus",
    "corpus": "pnpm --filter @sender-check/corpus run corpus",
    "rules": "pnpm --filter @sender-check/corpus run rules",
    "docs:check": "node tools/check-docs.ts",
    "docs:claims": "node tools/check-doc-claims.ts",
    "changelog:check": "node tools/check-changelog.ts",
    "repo:settings": "node tools/check-repo-settings.ts",
    "console:build": "pnpm --filter @sender-check/console run build",
    "extension:build": "pnpm --filter @sender-check/extension run build",
    "extension:zip": "pnpm --filter @sender-check/extension run zip",
    "example": "pnpm --filter @sender-check/examples run start"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
